# submit-feedback has no access code: the installer is public, so anything in it is public.
# It is protected by limits on the server (optional overrides, set with: supabase secrets set NAME=value):
#   FEEDBACK_ENABLED=false           switch the endpoint off at once (it answers 503)
#   FEEDBACK_MAX_PER_INSTALL_HOUR=5  reports one install may send per hour
#   FEEDBACK_MAX_PER_INSTALL_DAY=15  reports one install may send per day
#   FEEDBACK_MAX_PER_DAY=300         reports accepted from everyone together per day
#   FEEDBACK_MAX_SCREENSHOTS_DAY=60  screenshots stored from everyone together per day

# Read-only feedback report (scripts/feedback-report.mjs). Dashboard > Project Settings > API > service_role.
# Keep it secret: it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=
