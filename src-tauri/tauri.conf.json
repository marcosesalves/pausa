{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pausa",
  "version": "0.2.0-beta.1",
  "identifier": "io.pausa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pausa",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 520,
        "maxWidth": 960,
        "maxHeight": 900,
        "center": true,
        "visible": false,
        "resizable": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray/sprout@2x.png",
      "iconAsTemplate": true
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
